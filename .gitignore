# Local source material not committed
sources/**/ocr.txt
sources/**/ocr.md
sources/**/*.pdf
sources/**/scans/
sources/**/raw/

# Local-only workspaces
local_data/
local_exports/

# Generated exports (regenerated build artifacts — not versioned)
exports/generated/*
# …but keep the directory's documentation tracked
!exports/generated/README.md

# Python / local tooling
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
